{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[plugin-demo] PostToolUse hook 触发' >&2",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "wasm",
            "wasm": "${PLUGIN_ROOT}/bin/zhuye-demo-hook.wasm",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
